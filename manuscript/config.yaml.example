# Reference copy of manuscript/config.yaml — shows every configurable field.

paper:
  title: "Thunderball: DISCO VOLANTE — Special-Agent Mission Software"
  subtitle: "Dive Planning, NATO Convoy Integrity, and Submersible Logistics"
  version: "0.1.0"
  date: "YYYY-MM-DD"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

publication:
  journal: "BOND Film Series — Internal"
  year: "2026"

keywords:
  - "dive planning"
  - "convoy integrity"
  - "submersible logistics"

mission:
  film: "thunderball"
  codename: "DISCO VOLANTE"
  default_seed: 7
  recovery:
    depth_m: 40
    cylinder_capacity_l: 12
    fill_pressure_bar: 207
    sac_rate_lmin: 20
  screen:
    escort_bearings: [0, 45, 90, 135, 180, 225, 270, 315]
    half_angle_deg: 30
    coverage_target: 0.9
  submersible:
    energy_kwh: 400
    drag_coeff: 0.035
    hotel_kw: 2.0
  sonar:
    f_khz: 10.0
    sl_db: 150.0
    nl_db: 75.0
    di_db: 15.0
    dt_db: 10.0
    max_range_nm: 120.0
  navigation:
    track_deg: 315.0
    speed_knots: 4.0
    current_set_deg: 90.0
    current_drift_knots: 0.8
    recovery_radius_nm: 1.0
  interdiction:
    convoy_course_deg: 45.0
    convoy_speed_knots: 12.0
    threat_position: [5.0, -2.0]
    threat_course_deg: 270.0
    threat_speed_knots: 20.0
    screen_radius_nm: 2.0
    min_separation_nm: 1.0
    reaction_time_h: 0.05
